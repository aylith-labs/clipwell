<!--
  Clipwell design tokens: a zinc neutral ramp with one violet accent, matching
  the webui (Tailwind zinc + violet) and the product gradient #7c3aed → #a78bfa.
  Overriding the SystemAccentColor family recolors stock Fluent controls (focus
  rings, ComboBox highlights, carets) without retemplating anything. See ADR-0008.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#7C3AED</Color>
            <Color x:Key="SystemAccentColorDark1">#6D28D9</Color>
            <Color x:Key="SystemAccentColorDark2">#5B21B6</Color>
            <Color x:Key="SystemAccentColorDark3">#4C1D95</Color>
            <Color x:Key="SystemAccentColorLight1">#8B5CF6</Color>
            <Color x:Key="SystemAccentColorLight2">#A78BFA</Color>
            <Color x:Key="SystemAccentColorLight3">#C4B5FD</Color>

            <!-- Slightly translucent card so the acrylic blur reads through. -->
            <SolidColorBrush x:Key="ClipCardBackground" Color="#F2FAFAFA" />
            <SolidColorBrush x:Key="ClipSurface1" Color="#99E4E4E7" />
            <SolidColorBrush x:Key="ClipSurfaceHover" Color="#B3E4E4E7" />
            <SolidColorBrush x:Key="ClipBorder" Color="#E4E4E7" />
            <SolidColorBrush x:Key="ClipTextPrimary" Color="#18181B" />
            <SolidColorBrush x:Key="ClipTextSecondary" Color="#71717A" />
            <SolidColorBrush x:Key="ClipTextTertiary" Color="#A1A1AA" />
            <SolidColorBrush x:Key="ClipAccent" Color="#7C3AED" />
            <SolidColorBrush x:Key="ClipAccentHover" Color="#6D28D9" />
            <SolidColorBrush x:Key="ClipAccentMuted" Color="#217C3AED" />
            <SolidColorBrush x:Key="ClipOnAccent" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ClipHighlight" Color="#80FBBF24" />
            <SolidColorBrush x:Key="ClipDanger" Color="#DC2626" />
            <SolidColorBrush x:Key="ClipDangerSurface" Color="#1ADC2626" />

            <!-- Fluent list selection: accent-tinted surface, not a solid fill. -->
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#217C3AED" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#2E7C3AED" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#3D7C3AED" />
            <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#B3E4E4E7" />
            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#E4E4E7" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#A78BFA</Color>
            <Color x:Key="SystemAccentColorDark1">#8B5CF6</Color>
            <Color x:Key="SystemAccentColorDark2">#7C3AED</Color>
            <Color x:Key="SystemAccentColorDark3">#6D28D9</Color>
            <Color x:Key="SystemAccentColorLight1">#C4B5FD</Color>
            <Color x:Key="SystemAccentColorLight2">#DDD6FE</Color>
            <Color x:Key="SystemAccentColorLight3">#EDE9FE</Color>

            <SolidColorBrush x:Key="ClipCardBackground" Color="#F218181B" />
            <SolidColorBrush x:Key="ClipSurface1" Color="#9927272A" />
            <SolidColorBrush x:Key="ClipSurfaceHover" Color="#B327272A" />
            <SolidColorBrush x:Key="ClipBorder" Color="#3F3F46" />
            <SolidColorBrush x:Key="ClipTextPrimary" Color="#F4F4F5" />
            <SolidColorBrush x:Key="ClipTextSecondary" Color="#A1A1AA" />
            <SolidColorBrush x:Key="ClipTextTertiary" Color="#71717A" />
            <SolidColorBrush x:Key="ClipAccent" Color="#A78BFA" />
            <SolidColorBrush x:Key="ClipAccentHover" Color="#C4B5FD" />
            <SolidColorBrush x:Key="ClipAccentMuted" Color="#26A78BFA" />
            <SolidColorBrush x:Key="ClipOnAccent" Color="#18181B" />
            <SolidColorBrush x:Key="ClipHighlight" Color="#59FBBF24" />
            <SolidColorBrush x:Key="ClipDanger" Color="#F87171" />
            <SolidColorBrush x:Key="ClipDangerSurface" Color="#26F87171" />

            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#26A78BFA" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#33A78BFA" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#42A78BFA" />
            <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#B327272A" />
            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#27272A" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Shared (theme-independent) -->
    <CornerRadius x:Key="ClipRadiusS">6</CornerRadius>
    <CornerRadius x:Key="ClipRadiusM">8</CornerRadius>
    <CornerRadius x:Key="ClipRadiusL">12</CornerRadius>
    <x:Double x:Key="ClipFontSearch">15</x:Double>
    <x:Double x:Key="ClipFontBody">13.5</x:Double>
    <x:Double x:Key="ClipFontMeta">11</x:Double>
    <FontFamily x:Key="ClipFontMono">Cascadia Code,Consolas,Menlo,monospace</FontFamily>
</ResourceDictionary>
